# Groq Console'dan alınan API anahtarı -> https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Görsel destekli (vision) model. Groq'un vision destekli modeli değişebilir,
# güncel liste için: https://console.groq.com/docs/vision
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Sunucu portu (Render bunu otomatik PORT değişkeni ile sağlar, elle değiştirmene gerek yok)
PORT=10000

# Android uygulamasından gelen isteklerde beklenen basit API anahtarı (isteğe bağlı ama önerilir).
# Boş bırakılırsa doğrulama yapılmaz.
APP_API_KEY=change-me-please

# Dakikada izin verilen istek sayısı (basit rate-limit)
RATE_LIMIT_PER_MINUTE=20
